# Copy to .env.api (read by the api service only). Never commit .env.api.
# See docs/reference/control-plane-api.md for all CORVUS_API_* settings.

# Local development ONLY: a static bearer token that grants CORVUS_API_DEV_TOKEN_ROLES (default: admin).
# Leave empty to disable. Never set it in a shared or production environment. E.g.: openssl rand -hex 24
CORVUS_API_DEV_TOKEN=
# CORVUS_API_DEV_TOKEN_ROLES=["admin"]

# OIDC (use instead of the dev token). Tokens must be RS256 or ES256.
CORVUS_API_OIDC_ISSUER=
CORVUS_API_OIDC_AUDIENCE=
CORVUS_API_OIDC_JWKS_URL=
# Claim that holds the roles and an optional mapping of external role names to Corvus roles:
# CORVUS_API_ROLES_CLAIM=realm_access.roles
# CORVUS_API_ROLE_MAPPING={"corvus-admin": "admin", "corvus-ds": "data_scientist"}

# Pseudonym key: the same value the proxies use (base64, at least 16 bytes), e.g.: openssl rand -base64 32
# Without it, player lookup and erasure by UUID are disabled (erasure by pseudonym still works).
CORVUS_PSEUDONYM_KEY=
CORVUS_PSEUDONYM_KEY_ID=k1

# API tokens of the proxies for GET /api/v1/plugin/blocklist, comma separated, e.g.: openssl rand -hex 24
CORVUS_API_PLUGIN_TOKENS=
