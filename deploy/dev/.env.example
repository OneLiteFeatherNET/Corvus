# Copy to .env and fill in. Never commit .env. Compose reads every credential from this file.
# Variables that appear twice are read by different containers and must hold the same value.

# PostgreSQL password, e.g.: openssl rand -hex 16
POSTGRES_PASSWORD=
# Same value as POSTGRES_PASSWORD; libpq (psycopg) in the ingest service reads it from here.
PGPASSWORD=

# S3 credentials of the dev object store; the secret needs at least 8 characters, e.g.: openssl rand -hex 16
RUSTFS_ACCESS_KEY=corvus
RUSTFS_SECRET_KEY=
# Same values as the two lines above; the ingest service and the bucket init job read these.
CORVUS_S3_ACCESS_KEY=corvus
CORVUS_S3_SECRET_KEY=

# Key encryption key: base64 of 32 random bytes, e.g.: openssl rand -base64 32
# Losing it makes every stored player key (and therefore all raw payloads) unreadable.
CORVUS_KEK=
CORVUS_KEK_ID=dev-kek-1
