# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Velocity modern forwarding secret shared by proxy and both backends.
#   openssl rand -base64 24 | tr -d '\n=+/'
VELOCITY_FORWARDING_SECRET=

# HMAC key for player pseudonyms (read by Corvus as CORVUS_PSEUDONYM_KEY).
#   openssl rand -base64 32
CORVUS_PSEUDONYM_KEY=

# Host interface/port the proxy listens on. Loopback keeps the pilot private.
PROXY_BIND=127.0.0.1
PROXY_PORT=25565

# Set to TRUE to accept the Minecraft EULA (https://aka.ms/MinecraftEULA).
EULA=FALSE
